{
  "release-type": "simple",
  "tag-separator": "-",
  "separate-pull-requests": true,
  "changelog-types": [
    { "type": "feat", "section": "feat", "hidden": false },
    { "type": "fix", "section": "fix", "hidden": false },
    { "type": "chore", "section": "chore", "hidden": false }
  ],
  "packages": {
    "app-a": {
      "component": "app-a",
      "package-name": "app-a"
    },
    "app-b": {
      "component": "app-b",
      "package-name": "app-b"
    },
    "app-c": {
      "component": "app-c",
      "package-name": "app-c"
    }
  },
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "app-ab",
      "components": ["app-a", "app-b"]
    }
  ]
}
